{
  "name": "obsidian-vessel",
  "version": "0.1.0",
  "description": "Connects Obsidian to the Metabob activity system as a knowledge vessel",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:integration": "bun test/integration/http-harness.ts",
    "test:integration:port": "bun test/integration/http-harness.ts --port"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "metabob",
    "vessel"
  ],
  "author": "Metabob",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "bun-types": "^1.3.14",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.3.0"
  },
  "sideEffects": true
}
